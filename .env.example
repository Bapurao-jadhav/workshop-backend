# Copy to .env for local development (the app loads ./.env automatically). Never commit the real file.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workshop_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Security (JWT_SECRET must be at least 32 characters; generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# --- First admin, created on startup if it does not exist yet ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# --- CORS: comma separated origins of your React app (wildcards allowed, e.g. https://*.vercel.app) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# --- Frontend URL used to build password reset links (no trailing slash required) ---
FRONTEND_URL=https://your-app.vercel.app

# --- Business time zone used for workshop dates and deadlines ---
APP_TIMEZONE=Asia/Kolkata

# --- Brevo transactional email API (HTTPS; recommended for Render) ---
# Create an API key in Brevo, and verify the sender address before sending.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=arQnare
MAIL_FROM=verified-sender@example.com

# --- Optional: set to "validate" to make Hibernate verify the schema against the entities ---
# JPA_DDL_AUTO=validate

# --- Google Form webhook: the Apps Script on each workshop's form sends this value in the X-Webhook-Secret header.
# Leave empty to disable the webhook. Generate with: openssl rand -hex 24
GOOGLE_FORM_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Set to false to accept requests only from the webhook (hides the "I submitted" fallback).
# GOOGLE_FORM_ALLOW_USER_CLAIM=true
