# Copy to .env for local development (the app loads ./.env automatically). Never commit the real file.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workshop_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Security (JWT_SECRET must be at least 32 characters; generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# --- First admin, created on startup if it does not exist yet ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# --- CORS: comma separated origins of your React app (wildcards allowed, e.g. https://*.vercel.app) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# --- Business time zone used for workshop dates and deadlines ---
APP_TIMEZONE=Asia/Kolkata

# --- Email (optional). Leave MAIL_HOST empty to skip sending; emails are then only logged. ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com

# --- Optional: set to "validate" to make Hibernate verify the schema against the entities ---
# JPA_DDL_AUTO=validate
